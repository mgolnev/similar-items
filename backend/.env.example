# --- Clever similar-items backend ---

# HTTP-порт сервиса
PORT=8080

# Независимая БД сервиса (PostgreSQL на 5435). Обязателен.
DATABASE_URL=postgresql://similar:similar@localhost:5435/similar?sslmode=disable

# Источник фида товаров. Обязательное подключение для каждого окружения.
FEED_URL=https://catalog.example.com/products.xml

# Расписание автозагрузки фида: 1h, 30m, 6h … либо 0 чтобы отключить планировщик
FEED_SYNC_INTERVAL=1h

# Мягкий потолок кучи Go (≈0.7× памяти пода) — страховка GC во время прогрева кэша
# GOMEMLIMIT=5GiB
