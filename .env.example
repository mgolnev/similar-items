# Product feed used by Clever. Copy this file to .env and provide a real URL.
FEED_URL=https://catalog.example.com/products.xml
FEED_SYNC_INTERVAL=1h

# Local ports. Change them if another project already uses these ports.
BACKEND_PORT=8080
ADMIN_PORT=3000
POSTGRES_PORT=5435

# Local database credentials. Use secrets in production.
POSTGRES_DB=similar_items
POSTGRES_USER=similar_items
POSTGRES_PASSWORD=change-me

# Storefront origin used by links in the admin UI.
PRODUCT_SITE_ORIGIN=https://shop.example.com

# Cache warm-up limits.
WARM_TIMEOUT=30m
WARM_WORKERS=2
